{
  "function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:n}) {", "\t$0", "}"],
    "description": "function definition"
  },
  "program": {
    "prefix": "main",
    "body": ["fn main() {", "\t$0", "\treturn 0;", "}"],
    "description": "program entry point"
  },
  "variable": {
    "prefix": "var",
    "body": ["var ${1:x} = ${2:0};"],
    "description": "assignable local"
  },
  "constant": {
    "prefix": "let",
    "body": ["let ${1:x} = ${2:0};"],
    "description": "frozen local"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:i < n}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "if statement"
  },
  "print": {
    "prefix": "print",
    "body": ["print(${1:value});"],
    "description": "print a value and a newline"
  }
}
