{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mini",
  "scopeName": "source.mini",
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#calls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.double-slash.mini", "match": "//.*$" }]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.mini",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.mini" },
            "2": { "name": "entity.name.function.mini" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mini",
          "match": "\\b(let|var|return|if|else|while|break|continue)\\b"
        },
        { "name": "support.function.builtin.mini", "match": "\\b(print)\\b" }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "meta.call.mini",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.mini" } }
        }
      ]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.mini", "match": "\\b\\d+\\b" }]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mini",
          "match": "(\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|=|<|>|!)"
        }
      ]
    },
    "punctuation": {
      "patterns": [{ "name": "punctuation.mini", "match": "[(){},;]" }]
    }
  }
}
