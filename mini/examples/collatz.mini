fn steps(n) {
  var x = n;
  var k = 0;
  while (x != 1) {
    if (x % 2 == 0) {
      x = x / 2;
    } else {
      x = 3 * x + 1;
    }
    k = k + 1;
  }
  return k;
}

fn main() {
  var best = 0;
  var arg = 0;
  var i = 1;
  while (i < 1000) {
    let s = steps(i);
    if (s > best) {
      best = s;
      arg = i;
    }
    i = i + 1;
  }
  print(arg);
  print(best);
  return 0;
}
