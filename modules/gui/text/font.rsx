fn gui_font_rows() -> ptr<u8> {
    return "@@@@@@@DDDDD@DJJ@@@@@JJ_J_JJD^ENTODCSHDBYXFIEBUIVDD@@@@@HDBBBDHBDHHHDB@DUNUD@@DD_DD@@@@@@DB@@@_@@@@@@@@FFPHDDBAANQYUSQNDFDDDDNNQPHDB_OPPNPPOHLJI_HH_AOPPQNLBAOQQN_PHDBBBNQQNQQNNQQ^PHF@DD@DD@@DD@DBAHDBABDH@@_@_@@BDHPHDBNQPHD@DNQ]U]ANDJQQ_QQOQQOQQONQAAAQNGIQQQIG_AAOAA__AAOAAANQA]QQNQQQ_QQQNDDDDDN\\HHHHIFQIECEIQAAAAAA_Q[UUQQQQSUYQQQNQQQQQNOQQOAAANQQQUIVOQQOEIQ^AANPPO_DDDDDDQQQQQQNQQQQQJDQQQUU[QQQJDJQQQQJDDDD_PHDBA_NBBBBBNAABDHPPNHHHHHNDJQ@@@@@@@@@@_BD@@@@@@@NP^Q^AAOQQQO@@NAAQNPP^QQQ^@@NQ_ANLRBGBBB@^QQ^PNAAOQQQQD@FDDDNH@HHHIFAAIECEIFDDDDDN@@KUUUQ@@OQQQQ@@NQQQN@@OQQOA@@^QQ^P@@MSAAA@@^ANPOBBGBBRL@@QQQYV@@QQQJD@@QQUUJ@@QJDJQ@@QQ^PN@@_HDB_XDDBDDXDDDDDDDCDDHDDC@@RUI@@";
}

fn gui_font_row(c: i64, r: i64) -> u8 {
    if (c < 32 || c > 126 || r < 0 || r > 6) {
        return 0;
    }
    let t: ptr<u8> = gui_font_rows();
    var v: u8 = 0;
    let at: i64 = (c - 32) * 7 + r;
    unsafe {
        v = t[at];
    }
    return ((v - 64) as u8) & 31;
}
