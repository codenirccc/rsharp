func @main() -> i64 {
entry:
  %0 = alloca i64, 10
  br fill
fill:
  %1 = phi i64 [ 0, entry ], [ %5, fill ]
  %2 = gep i64, ptr %0, i64 %1
  %3 = mul i64 %1, %1
  store i64 %3, ptr %2
  %4 = icmp slt i64 %1, 9
  %5 = add i64 %1, 1
  condbr %4, fill, sum
sum:
  %6 = phi i64 [ 0, fill ], [ %11, sum ]
  %7 = phi i64 [ 0, fill ], [ %10, sum ]
  %8 = gep i64, ptr %0, i64 %6
  %9 = load i64, ptr %8
  %10 = add i64 %7, %9
  %11 = add i64 %6, 1
  %12 = icmp slt i64 %11, 10
  condbr %12, sum, done
done:
  ret i64 %10
}
