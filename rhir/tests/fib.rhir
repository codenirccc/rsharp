func @fib(i64 %0) -> i64 {
entry:
  %1 = icmp sle i64 %0, 1
  condbr %1, base, rec
base:
  ret i64 %0
rec:
  %2 = sub i64 %0, 1
  %3 = call i64 @fib(i64 %2)
  %4 = sub i64 %0, 2
  %5 = call i64 @fib(i64 %4)
  %6 = add i64 %3, %5
  ret i64 %6
}

func @main() -> i64 {
entry:
  %0 = call i64 @fib(i64 20)
  ret i64 %0
}
