declare i64 @GetStdHandle(i64)
declare i64 @WriteFile(i64, ptr, i64, ptr, ptr)

global @num = "01234567890123456789"
global @nl = "\n"

func @fmt(i64 %0) -> i64 {
entry:
  %1 = gep i8, ptr @num, i64 20
  %2 = icmp ule i64 %0, 0
  condbr %2, zero, loop
zero:
  %3 = gep i8, ptr %1, i64 -1
  store i8 48, ptr %3
  ret i64 %3
loop:
  %4 = phi i64 [ %0, entry ], [ %7, body ]
  %5 = phi i64 [ %1, entry ], [ %10, body ]
  %6 = icmp sgt i64 %4, 0
  condbr %6, body, done
body:
  %7 = sdiv i64 %4, 10
  %8 = mul i64 %7, 10
  %9 = sub i64 %4, %8
  %10 = gep i8, ptr %5, i64 -1
  %11 = add i64 %9, 48
  %12 = trunc i64 %11 to i8
  store i8 %12, ptr %10
  br loop
done:
  ret i64 %5
}

func @main() -> i64 {
entry:
  %0 = alloca i64, 1
  %1 = call i64 @fmt(i64 20261114)
  %2 = call i64 @GetStdHandle(i64 -11)
  %3 = gep i8, ptr @num, i64 20
  %4 = sub i64 %3, %1
  %5 = call i64 @WriteFile(i64 %2, ptr %1, i64 %4, ptr %0, ptr 0)
  %6 = call i64 @WriteFile(i64 %2, ptr @nl, i64 1, ptr %0, ptr 0)
  ret i64 0
}
