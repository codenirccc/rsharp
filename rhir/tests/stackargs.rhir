func @add6(i64 %0, i64 %1, i64 %2, i64 %3, i64 %4, i64 %5) -> i64 {
entry:
  %6 = add i64 %0, %1
  %7 = add i64 %6, %2
  %8 = add i64 %7, %3
  %9 = add i64 %8, %4
  %10 = add i64 %9, %5
  ret i64 %10
}

func @main() -> i64 {
entry:
  %0 = call i64 @add6(i64 1, i64 2, i64 3, i64 4, i64 5, i64 6)
  ret i64 %0
}
