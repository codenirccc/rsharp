declare i64 @GetStdHandle(i64)
declare i64 @WriteFile(i64, ptr, i64, ptr, ptr)

global @msg = "rhir says hello from a hand written PE\n"

func @strlen(ptr %0) -> i64 {
entry:
  br loop
loop:
  %1 = phi i64 [ 0, entry ], [ %2, loop ]
  %2 = add i64 %1, 1
  %3 = gep i8, ptr %0, i64 %2
  %4 = load i8, ptr %3
  %5 = icmp ne i8 %4, 0
  condbr %5, loop, done
done:
  ret i64 %1
}

func @main() -> i64 {
entry:
  %0 = alloca i64, 1
  %1 = call i64 @strlen(ptr @msg)
  %2 = call i64 @GetStdHandle(i64 -11)
  %3 = call i64 @WriteFile(i64 %2, ptr @msg, i64 %1, ptr %0, ptr 0)
  ret i64 %1
}
