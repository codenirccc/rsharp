// work/http/t_der.rsx — DER reader against inline encodings and a real cert.
// Generated by gen_der_test.py; the expectations come from Python cryptography.
include "../../modules/http/der.rsx";

fn load(out: ptr<u8>, s: ptr<u8>, maxn: i64) -> i64 {
    return rt_parse_hex(s, out, maxn);
}

// Pulls the first commonName out of an RDNSequence.
fn cn_of(name: &mut Tlv, out: ptr<u8>, maxn: i64) -> i32 {
    var d: Der = zero(Der);
    der_sub(name, &mut d);
    var set: Tlv = zero(Tlv);
    while (der_next(&mut d, &mut set) == 0) {
        var sd: Der = zero(Der);
        der_sub(&mut set, &mut sd);
        var atv: Tlv = zero(Tlv);
        while (der_next(&mut sd, &mut atv) == 0) {
            var ad: Der = zero(Der);
            der_sub(&mut atv, &mut ad);
            var oid: Tlv = zero(Tlv);
            var val: Tlv = zero(Tlv);
            if (der_next(&mut ad, &mut oid) != 0) {
                break;
            }
            if (der_next(&mut ad, &mut val) != 0) {
                break;
            }
            var cnoid: [u8; 8] = [0];
            var cp: ptr<u8> = null;
            unsafe { cp = &mut cnoid[0] as ptr<u8>; }
            rt_parse_hex("550403", cp, 8);
            if (der_oid_eq(&mut oid, cp, 3) == 1) {
                if (val.len > maxn) {
                    return -1;
                }
                rt_copy(out, val.p, val.len);
                rt_setbyte(out, val.len, 0);
                return 0;
            }
        }
    }
    return -1;
}

fn check(name: ptr<u8>, got: i64, want: i64) -> i32 {
    if (got == want) {
        printf("%s ok\n", name);
        return 1;
    }
    printf("%s FAIL got=%lld want=%lld\n", name, got, want);
    return 0;
}

fn main() -> i32 {
    var ok: i32 = 0;
    var total: i32 = 0;

    // Two INTEGERs inside a short-form SEQUENCE: 300602012a020107
    var b1: [u8; 64] = [0];
    var p1: ptr<u8> = null;
    unsafe { p1 = &mut b1[0] as ptr<u8>; }
    let n1: i64 = load(p1, "300602012a020107", 64);
    var d1: Der = zero(Der);
    der_init(&mut d1, p1, n1);
    var seq: Tlv = zero(Tlv);
    var sd1: Der = zero(Der);
    var i1: Tlv = zero(Tlv);
    var i2: Tlv = zero(Tlv);
    var v1: [u8; 8] = [0];
    var v2: [u8; 8] = [0];
    var vp1: ptr<u8> = null;
    var vp2: ptr<u8> = null;
    unsafe {
        vp1 = &mut v1[0] as ptr<u8>;
        vp2 = &mut v2[0] as ptr<u8>;
    }
    var r1: i64 = -1;
    var r2: i64 = -1;
    if (der_expect(&mut d1, 48, &mut seq) == 0) {
        der_sub(&mut seq, &mut sd1);
        if (der_next(&mut sd1, &mut i1) == 0) {
            r1 = der_uint(&mut i1, vp1, 8);
        }
        if (der_next(&mut sd1, &mut i2) == 0) {
            r2 = der_uint(&mut i2, vp2, 8);
        }
    }
    ok += check("seq_int1", r1, 1);
    total += 1;
    ok += check("seq_int2", r2, 1);
    total += 1;

    // UTCTime and GeneralizedTime for the same instant.
    var tb: [u8; 32] = [0];
    var tp: ptr<u8> = null;
    unsafe { tp = &mut tb[0] as ptr<u8>; }
    var tz: Tlv = zero(Tlv);
    var dt: Der = zero(Der);
    let tn: i64 = load(tp, "170d3234303130313030303030305a", 32);
    der_init(&mut dt, tp, tn);
    var tv: i64 = -1;
    if (der_next(&mut dt, &mut tz) == 0) {
        tv = der_time(&mut tz);
    }
    ok += check("utctime", tv, 1704067200);
    total += 1;

    let gn: i64 = load(tp, "180f32303234303130313030303030305a", 32);
    der_init(&mut dt, tp, gn);
    tv = -1;
    if (der_next(&mut dt, &mut tz) == 0) {
        tv = der_time(&mut tz);
    }
    ok += check("gentime", tv, 1704067200);
    total += 1;

    // Truncated input must fail closed.
    der_init(&mut dt, tp, 3);
    ok += check("truncated", (der_next(&mut dt, &mut tz)) as i64, -1);
    total += 1;

    // The real leaf certificate.
    var cb: [u8; 2048] = [0];
    var cp: ptr<u8> = null;
    unsafe { cp = &mut cb[0] as ptr<u8>; }
    let cn: i64 = load(cp, "", 2048);
    var cd: Der = zero(Der);
    der_init(&mut cd, cp, cn);
    var cert: Tlv = zero(Tlv);
    ok += check("cert_outer", (der_expect(&mut cd, 48, &mut cert)) as i64, 0);
    total += 1;
    ok += check("cert_size", cert.hdr + cert.len, 765);
    total += 1;

    var csd: Der = zero(Der);
    der_sub(&mut cert, &mut csd);
    var tbs: Tlv = zero(Tlv);
    ok += check("tbs_read", (der_next(&mut csd, &mut tbs)) as i64, 0);
    total += 1;
    ok += check("tbs_len", tbs.hdr + tbs.len, 485);
    total += 1;

    var td: Der = zero(Der);
    der_sub(&mut tbs, &mut td);
    var ver: Tlv = zero(Tlv);
    var serial: Tlv = zero(Tlv);
    var salg: Tlv = zero(Tlv);
    var issuer: Tlv = zero(Tlv);
    var validity: Tlv = zero(Tlv);
    var subject: Tlv = zero(Tlv);
    var spki: Tlv = zero(Tlv);
    var steps: i32 = 0;
    if (der_peek(&mut td, &mut ver) == 0 && ver.tag == 160) {
        der_skip(&mut td);
    }
    if (der_next(&mut td, &mut serial) == 0) { steps += 1; }
    if (der_next(&mut td, &mut salg) == 0) { steps += 1; }
    if (der_next(&mut td, &mut issuer) == 0) { steps += 1; }
    if (der_next(&mut td, &mut validity) == 0) { steps += 1; }
    if (der_next(&mut td, &mut subject) == 0) { steps += 1; }
    if (der_next(&mut td, &mut spki) == 0) { steps += 1; }
    ok += check("tbs_fields", steps as i64, 6);
    total += 1;

    var ser: [u8; 16] = [0];
    var serp: ptr<u8> = null;
    unsafe { serp = &mut ser[0] as ptr<u8>; }
    var ser_hex: [u8; 40] = [0];
    var serh: ptr<u8> = null;
    unsafe { serh = &mut ser_hex[0] as ptr<u8>; }
    let sl: i64 = der_uint(&mut serial, serp, 16);
    rt_hex_str(serh, serp, sl);
    ok += check("serial", (rt_eq(serh, "0fedcba987654321")) as i64, 1);
    total += 1;

    var vd: Der = zero(Der);
    der_sub(&mut validity, &mut vd);
    var nbf: Tlv = zero(Tlv);
    var naf: Tlv = zero(Tlv);
    var t1: i64 = -1;
    var t2: i64 = -1;
    if (der_next(&mut vd, &mut nbf) == 0) {
        t1 = der_time(&mut nbf);
    }
    if (der_next(&mut vd, &mut naf) == 0) {
        t2 = der_time(&mut naf);
    }
    ok += check("not_before", t1, 1717200000);
    total += 1;
    ok += check("not_after", t2, 1780272000);
    total += 1;

    var cnbuf: [u8; 128] = [0];
    var cnp: ptr<u8> = null;
    unsafe { cnp = &mut cnbuf[0] as ptr<u8>; }
    rt_zero(cnp, 128);
    let crc: i32 = cn_of(&mut issuer, cnp, 100);
    ok += check("issuer_cn", (crc + rt_eq(cnp, "R# Test CA")) as i64, 1);
    total += 1;

    var scn: [u8; 128] = [0];
    var scnp: ptr<u8> = null;
    unsafe { scnp = &mut scn[0] as ptr<u8>; }
    rt_zero(scnp, 128);
    der_sub(&mut subject, &mut td);
    let src: i32 = cn_of(&mut subject, scnp, 100);
    ok += check("subject_cn", (src + rt_eq(scnp, "leaf.test")) as i64, 1);
    total += 1;

    // SPKI: SEQUENCE { AlgorithmIdentifier, BIT STRING { RSAPublicKey } }
    var kd: Der = zero(Der);
    der_sub(&mut spki, &mut kd);
    var alg: Tlv = zero(Tlv);
    var bits: Tlv = zero(Tlv);
    var modlen: i64 = -1;
    if (der_next(&mut kd, &mut alg) == 0) {
        if (der_next(&mut kd, &mut bits) == 0) {
            var rsa: Tlv = zero(Tlv);
            var rd: Der = zero(Der);
            der_init(&mut rd, rt_add(bits.p, 1), bits.len - 1);
            if (der_expect(&mut rd, 48, &mut rsa) == 0) {
                var r2d: Der = zero(Der);
                var modt: Tlv = zero(Tlv);
                var exp: Tlv = zero(Tlv);
                der_sub(&mut rsa, &mut r2d);
                if (der_next(&mut r2d, &mut modt) == 0) {
                    if (der_next(&mut r2d, &mut exp) == 0) {
                        modlen = modt.len;
                        if (exp.len == 3) {
                            modlen += 0;
                        }
                    }
                }
            }
        }
    }
    ok += check("rsa_modulus", modlen, 257);
    total += 1;

    printf("der_passed=%d of %d\n", ok, total);
    if (ok == total) {
        return 0;
    }
    return 1;
}
