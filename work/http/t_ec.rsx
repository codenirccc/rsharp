fn check_i(name: ptr<u8>, got: i64, want: i64) -> i32 {
    if (got == want) {
        printf("%s ok\n", name);
        return 1;
    }
    printf("%s FAIL got=%lld want=%lld\n", name, got, want);
    return 0;
}

fn hexeq(name: ptr<u8>, b: &mut Bn, want: ptr<u8>, width: i64) -> i32 {
    var out: [u8; 120] = [0];
    var op: ptr<u8> = null;
    unsafe { op = &mut out[0] as ptr<u8>; }
    bn_to_be(b, op, width);
    var hex: [u8; 240] = [0];
    var hp: ptr<u8> = null;
    unsafe { hp = &mut hex[0] as ptr<u8>; }
    rt_hex_str(hp, op, width);
    if (rt_eq(hp, want) == 1) {
        printf("%s ok\n", name);
        return 1;
    }
    printf("%s FAIL\n  got  %s\n  want %s\n", name, hp, want);
    return 0;
}

