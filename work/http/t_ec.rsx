    rt_copy(badp_3, sgp_3, sgl_3);
    var lb_3: u8 = 0;
    unsafe { lb_3 = badp_3[sgl_3 - 1]; }
    rt_setbyte(rt_add(badp_3, sgl_3 - 1), 0, (lb_3 ^ 1) as u8);
    ok += check_i("ecdsa_bad_sig_3", ecdsa_verify(&mut ev_3, dgp_3, dgl_3, badp_3, sgl_3) as i64, 0);
    total += 1;
    var wd_3: [u8; 64] = [0];
    var wdp_3: ptr<u8> = null;
    unsafe { wdp_3 = &mut wd_3[0] as ptr<u8>; }
    rt_copy(wdp_3, dgp_3, dgl_3);
    rt_setbyte(wdp_3, 0, 170);
    ok += check_i("ecdsa_bad_digest_3", ecdsa_verify(&mut ev_3, wdp_3, dgl_3, sgp_3, sgl_3) as i64, 0);
    total += 1;

    printf("ec_passed=%d of %d\n", ok, total);
    if (ok == total) {
        return 0;
    }
    return 1;
}
