include "../../modules/http/roots_win.rsx";
include "../../modules/http/trust.rsx";

fn check(name: ptr<u8>, got: i64, want: i64) -> i32 {
    if (got == want) {
        printf("%s ok\n", name);
        return 1;
    }
    printf("%s FAIL got=%lld want=%lld\n", name, got, want);
    return 0;
}

fn main() -> i32 {
    var ok: i32 = 0;
    var total: i32 = 0;

    var stats: TrustStats = zero(TrustStats);
    ok += check("store_open", trust_store_stats(&mut stats) as i64, 0);
    total += 1;
    printf("store count=%lld parsed=%lld\n", stats.count, stats.parsed);
    ok += check("store_all_parse", stats.parsed, stats.count);
    total += 1;
    ok += check("store_has_roots", stats.count, 294);
    total += 1;

    let now: i64 = rt_time();
    printf("now=%lld\n", now);

    var lb_0: [u8; 4096] = [0];
    var lp_0: ptr<u8> = null;
    unsafe { lp_0 = &mut lb_0[0] as ptr<u8>; }
    let ll_0: i64 = rt_parse_hex("", lp_0, 4096);
    var ib_0: [u8; 4096] = [0];
    var ip_0: ptr<u8> = null;
    unsafe { ip_0 = &mut ib_0[0] as ptr<u8>; }
    let il_0: i64 = rt_parse_hex("", ip_0, 4096);
    ok += check("leaf_len_0", ll_0, 1914);
    total += 1;
    ok += check("inter_len_0", il_0, 1314);
    total += 1;

    var cb_0: [u8; 8192] = [0];
    var cp_0: ptr<u8> = null;
    unsafe { cp_0 = &mut cb_0[0] as ptr<u8>; }
    rt_copy(cp_0, lp_0, ll_0);
    rt_copy(rt_add(cp_0, ll_0), ip_0, il_0);
    var ch_0: X509Chain = zero(X509Chain);
    x509_chain_init(&mut ch_0, cp_0);
    x509_chain_add(&mut ch_0, 0, ll_0);
    x509_chain_add(&mut ch_0, ll_0, il_0);

    ok += check("verify_0", trust_verify(&mut ch_0, "www.apple.com", rt_len("www.apple.com"), now) as i64, 1);
    total += 1;
    ok += check("wrong_host_0", trust_verify(&mut ch_0, "www.example.org", rt_len("www.example.org"), now) as i64, 0);
    total += 1;
    ok += check("leaf_expired_0", trust_verify(&mut ch_0, "www.apple.com", rt_len("www.apple.com"), 1810230840 + 1) as i64, 0);
    total += 1;
    ok += check("inter_expired_0", trust_verify(&mut ch_0, "www.apple.com", rt_len("www.apple.com"), 1902095999 + 1) as i64, 0);
    total += 1;
    ok += check("before_nb_0", trust_verify(&mut ch_0, "www.apple.com", rt_len("www.apple.com"), 1794424103 - 1) as i64, 0);
    total += 1;

    var lone_0: X509Chain = zero(X509Chain);
    x509_chain_init(&mut lone_0, lp_0);
    x509_chain_add(&mut lone_0, 0, ll_0);
    ok += check("no_anchor_0", trust_verify(&mut lone_0, "www.apple.com", rt_len("www.apple.com"), now) as i64, 0);
    total += 1;

    var bad_0: [u8; 8192] = [0];
    var bp_0: ptr<u8> = null;
    unsafe { bp_0 = &mut bad_0[0] as ptr<u8>; }
    rt_copy(bp_0, cp_0, ll_0 + il_0);
    rt_setbyte(rt_add(bp_0, ll_0 + il_0 - 8), 0, 0);
    var badch_0: X509Chain = zero(X509Chain);
    x509_chain_init(&mut badch_0, bp_0);
    x509_chain_add(&mut badch_0, 0, ll_0);
    x509_chain_add(&mut badch_0, ll_0, il_0);
    ok += check("tampered_inter_0", trust_verify(&mut badch_0, "www.apple.com", rt_len("www.apple.com"), now) as i64, 0);
    total += 1;

    var lb_1: [u8; 4096] = [0];
    var lp_1: ptr<u8> = null;
    unsafe { lp_1 = &mut lb_1[0] as ptr<u8>; }
    let ll_1: i64 = rt_parse_hex("", lp_1, 4096);
    var ib_1: [u8; 4096] = [0];
    var ip_1: ptr<u8> = null;
    unsafe { ip_1 = &mut ib_1[0] as ptr<u8>; }
    let il_1: i64 = rt_parse_hex("", ip_1, 4096);
    ok += check("leaf_len_1", ll_1, 930);
    total += 1;
    ok += check("inter_len_1", il_1, 658);
    total += 1;

    var cb_1: [u8; 8192] = [0];
    var cp_1: ptr<u8> = null;
    unsafe { cp_1 = &mut cb_1[0] as ptr<u8>; }
    rt_copy(cp_1, lp_1, ll_1);
    rt_copy(rt_add(cp_1, ll_1), ip_1, il_1);
    var ch_1: X509Chain = zero(X509Chain);
    x509_chain_init(&mut ch_1, cp_1);
    x509_chain_add(&mut ch_1, 0, ll_1);
    x509_chain_add(&mut ch_1, ll_1, il_1);

    ok += check("verify_1", trust_verify(&mut ch_1, "www.cloudflare.com", rt_len("www.cloudflare.com"), now) as i64, 1);
    total += 1;
    ok += check("wrong_host_1", trust_verify(&mut ch_1, "www.example.org", rt_len("www.example.org"), now) as i64, 0);
    total += 1;
    ok += check("leaf_expired_1", trust_verify(&mut ch_1, "www.cloudflare.com", rt_len("www.cloudflare.com"), 1802443833 + 1) as i64, 0);
    total += 1;
    ok += check("inter_expired_1", trust_verify(&mut ch_1, "www.cloudflare.com", rt_len("www.cloudflare.com"), 1866290400 + 1) as i64, 0);
    total += 1;
    ok += check("before_nb_1", trust_verify(&mut ch_1, "www.cloudflare.com", rt_len("www.cloudflare.com"), 1794664282 - 1) as i64, 0);
    total += 1;

    var lone_1: X509Chain = zero(X509Chain);
    x509_chain_init(&mut lone_1, lp_1);
    x509_chain_add(&mut lone_1, 0, ll_1);
    ok += check("no_anchor_1", trust_verify(&mut lone_1, "www.cloudflare.com", rt_len("www.cloudflare.com"), now) as i64, 0);
    total += 1;

    var bad_1: [u8; 8192] = [0];
    var bp_1: ptr<u8> = null;
    unsafe { bp_1 = &mut bad_1[0] as ptr<u8>; }
    rt_copy(bp_1, cp_1, ll_1 + il_1);
    rt_setbyte(rt_add(bp_1, ll_1 + il_1 - 8), 0, 0);
    var badch_1: X509Chain = zero(X509Chain);
    x509_chain_init(&mut badch_1, bp_1);
    x509_chain_add(&mut badch_1, 0, ll_1);
    x509_chain_add(&mut badch_1, ll_1, il_1);
    ok += check("tampered_inter_1", trust_verify(&mut badch_1, "www.cloudflare.com", rt_len("www.cloudflare.com"), now) as i64, 0);
    total += 1;

    printf("trust_passed=%d of %d\n", ok, total);
    if (ok == total) {
        return 0;
    }
    return 1;
}
