// work/http/t_x509.rsx — parsing and path validation against real certs.
// Generated by gen_x509_test.py; the expectations come from Python cryptography.
include "../../modules/http/x509.rsx";

fn load(out: ptr<u8>, s: ptr<u8>, maxn: i64) -> i64 {
    return rt_parse_hex(s, out, maxn);
}

fn check(name: ptr<u8>, got: i64, want: i64) -> i32 {
    if (got == want) {
        printf("%s ok\n", name);
        return 1;
    }
    printf("%s FAIL got=%lld want=%lld\n", name, got, want);
    return 0;
}

fn main() -> i32 {
    var ok: i32 = 0;
    var total: i32 = 0;
    let nb: i64 = 1717200000;
    let na: i64 = 1780272000;
    let wnb: i64 = 1717200000;
    let wna: i64 = 1780272000;

    var cab: [u8; 2048] = [0];
    var cap: ptr<u8> = null;
    unsafe { cap = &mut cab[0] as ptr<u8>; }
    let cal: i64 = load(cap, "", 2048);

    var leb: [u8; 2048] = [0];
    var lep: ptr<u8> = null;
    unsafe { lep = &mut leb[0] as ptr<u8>; }
    let lel: i64 = load(lep, "", 2048);

    var wib: [u8; 2048] = [0];
    var wip: ptr<u8> = null;
    unsafe { wip = &mut wib[0] as ptr<u8>; }
    let wil: i64 = load(wip, "", 2048);

    var ca: X509 = zero(X509);
    ok += check("parse_ca", x509_parse(&mut ca, cap, cal) as i64, 0);
    total += 1;
    var lf: X509 = zero(X509);
    ok += check("parse_leaf", x509_parse(&mut lf, lep, lel) as i64, 0);
    total += 1;
    var lf2: X509 = zero(X509);
    x509_parse(&mut lf2, lep, lel);
    var wd: X509 = zero(X509);
    ok += check("parse_wild", x509_parse(&mut wd, wip, wil) as i64, 0);
    total += 1;

    ok += check("leaf_tbs_len", lf.tbs_len, 485);
    total += 1;
    ok += check("leaf_nb", lf.nb, nb);
    total += 1;
    ok += check("leaf_na", lf.na, na);
    total += 1;
    ok += check("leaf_sig_len", lf.sig_len, 256);
    total += 1;

    ok += check("ca_is_ca", x509_is_ca(&mut ca) as i64, 1);
    total += 1;
    ok += check("leaf_is_ca", x509_is_ca(&mut lf) as i64, 0);
    total += 1;
    ok += check("ca_ku_certsign", x509_ku_bit(&mut ca, 5) as i64, -1);
    total += 1;
    ok += check("leaf_ku_digsig", x509_ku_bit(&mut lf, 0) as i64, 1);
    total += 1;
    ok += check("leaf_ku_certsign", x509_ku_bit(&mut lf, 5) as i64, 0);
    total += 1;

    ok += check("host_ok", x509_check_host(&mut lf, "example.test", rt_len("example.test")) as i64, 1);
    total += 1;
    ok += check("host_case", x509_check_host(&mut lf, "EXAMPLE.TEST", rt_len("EXAMPLE.TEST")) as i64, 1);
    total += 1;
    ok += check("host_sub", x509_check_host(&mut lf, "www.example.test", rt_len("www.example.test")) as i64, 0);
    total += 1;
    ok += check("host_other", x509_check_host(&mut lf, "other.test", rt_len("other.test")) as i64, 0);
    total += 1;
    ok += check("host_suffix", x509_check_host(&mut lf, "notexample.test", rt_len("notexample.test")) as i64, 0);
    total += 1;

    ok += check("wild_labels", x509_check_host(&mut wd, "a.wild.test", rt_len("a.wild.test")) as i64, 1);
    total += 1;
    ok += check("wild_bare", x509_check_host(&mut wd, "wild.test", rt_len("wild.test")) as i64, 0);
    total += 1;
    ok += check("wild_deep", x509_check_host(&mut wd, "a.b.wild.test", rt_len("a.b.wild.test")) as i64, 0);
    total += 1;
    ok += check("wild_exact", x509_check_host(&mut wd, "exact.wild.test", rt_len("exact.wild.test")) as i64, 1);
    total += 1;
    ok += check("wild_ip", x509_check_host(&mut wd, "10.20.30.40", rt_len("10.20.30.40")) as i64, 1);
    total += 1;
    ok += check("wild_ip_bad", x509_check_host(&mut wd, "10.20.30.41", rt_len("10.20.30.41")) as i64, 0);
    total += 1;
    ok += check("wild_ip_short", x509_check_host(&mut wd, "10.20.30", rt_len("10.20.30")) as i64, 0);
    total += 1;

    ok += check("valid_in", x509_valid_at(&mut lf, nb + 1) as i64, 1);
    total += 1;
    ok += check("valid_before", x509_valid_at(&mut lf, nb - 1) as i64, 0);
    total += 1;
    ok += check("valid_after", x509_valid_at(&mut lf, na + 1) as i64, 0);
    total += 1;
    ok += check("leaf_ok", x509_leaf_ok(&mut lf, nb + 1) as i64, 1);
    total += 1;
    ok += check("leaf_ok_expired", x509_leaf_ok(&mut lf, na + 1) as i64, 0);
    total += 1;

    ok += check("sig_ok", x509_signed_by(&mut lf, &mut ca, nb + 1) as i64, 1);
    total += 1;
    ok += check("sig_selfish", x509_signed_by(&mut lf, &mut lf2, nb + 1) as i64, 0);
    total += 1;
    ok += check("sig_wrong_ca", x509_signed_by(&mut wd, &mut lf, nb + 1) as i64, 0);
    total += 1;

    var fpb: [u8; 40] = [0];
    var fpp: ptr<u8> = null;
    unsafe { fpp = &mut fpb[0] as ptr<u8>; }
    x509_fingerprint(&mut lf, fpp);
    var fh: [u8; 80] = [0];
    var fhp: ptr<u8> = null;
    unsafe { fhp = &mut fh[0] as ptr<u8>; }
    rt_hex_str(fhp, fpp, 32);
    ok += check("fingerprint", rt_eq(fhp, "ece514b93f5b68b737a776ebcf2c5f8d1e96eef83d4e5e64ca21eb79d9c672e0") as i64, 1);
    total += 1;

    // One-hop chain: leaf only, anchored at the CA.
    var chain: X509Chain = zero(X509Chain);
    x509_chain_init(&mut chain, lep);
    ok += check("chain_add", x509_chain_add(&mut chain, 0, lel) as i64, 0);
    total += 1;
    ok += check("chain_ok", x509_chain_verify(&mut chain, cap, cal, "example.test", rt_len("example.test"), nb + 100) as i64, 1);
    total += 1;
    ok += check("chain_bad_host", x509_chain_verify(&mut chain, cap, cal, "other.test", rt_len("other.test"), nb + 100) as i64, 0);
    total += 1;
    ok += check("chain_expired", x509_chain_verify(&mut chain, cap, cal, "example.test", rt_len("example.test"), na + 100) as i64, 0);
    total += 1;

    // Two-hop chain: leaf plus the CA cert the peer also sent.
    var cb: [u8; 4096] = [0];
    var cbp: ptr<u8> = null;
    unsafe { cbp = &mut cb[0] as ptr<u8>; }
    rt_copy(cbp, lep, lel);
    rt_copy(rt_add(cbp, lel), cap, cal);
    var chain2: X509Chain = zero(X509Chain);
    x509_chain_init(&mut chain2, cbp);
    x509_chain_add(&mut chain2, 0, lel);
    x509_chain_add(&mut chain2, lel, cal);
    ok += check("chain2_ok", x509_chain_verify(&mut chain2, cap, cal, "example.test", rt_len("example.test"), nb + 100) as i64, 1);
    total += 1;
    ok += check("chain2_count", chain2.n, 2);
    total += 1;

    // ==== ECDSA path ====
    var ecab: [u8; 2048] = [0];
    var ecap: ptr<u8> = null;
    unsafe { ecap = &mut ecab[0] as ptr<u8>; }
    let ecal: i64 = load(ecap, "", 2048);
    var elb: [u8; 2048] = [0];
    var elp: ptr<u8> = null;
    unsafe { elp = &mut elb[0] as ptr<u8>; }
    let ell: i64 = load(elp, "", 2048);
    var e3b: [u8; 2048] = [0];
    var e3p: ptr<u8> = null;
    unsafe { e3p = &mut e3b[0] as ptr<u8>; }
    let e3l: i64 = load(e3p, "", 2048);

    var eca: X509 = zero(X509);
    ok += check("parse_eca", x509_parse(&mut eca, ecap, ecal) as i64, 0);
    total += 1;
    var elf: X509 = zero(X509);
    ok += check("parse_eleaf", x509_parse(&mut elf, elp, ell) as i64, 0);
    total += 1;
    var e384: X509 = zero(X509);
    ok += check("parse_eleaf384", x509_parse(&mut e384, e3p, e3l) as i64, 0);
    total += 1;
    var eelf2: X509 = zero(X509);
    x509_parse(&mut eelf2, elp, ell);

    ok += check("eca_is_ca", x509_is_ca(&mut eca) as i64, 1);
    total += 1;
    ok += check("eca_ku_certsign", x509_ku_bit(&mut eca, 5) as i64, 1);
    total += 1;
    ok += check("eleaf_sig_len", elf.sig_len, 72);
    total += 1;
    ok += check("eleaf_tbs_len", elf.tbs_len, 255);
    total += 1;
    ok += check("eleaf_host", x509_check_host(&mut elf, "ec.test", rt_len("ec.test")) as i64, 1);
    total += 1;
    ok += check("ec384_host", x509_check_host(&mut e384, "ec384.test", rt_len("ec384.test")) as i64, 1);
    total += 1;

    ok += check("ecdsa_sig_ok", x509_signed_by(&mut elf, &mut eca, 1767225600) as i64, 1);
    total += 1;
    ok += check("ecdsa_sig_384", x509_signed_by(&mut e384, &mut eca, 1767225600) as i64, 1);
    total += 1;
    ok += check("ecdsa_wrong_issuer", x509_signed_by(&mut elf, &mut ca, 1767225600) as i64, 0);
    total += 1;
    ok += check("ecdsa_self", x509_signed_by(&mut elf, &mut eelf2, 1767225600) as i64, 0);
    total += 1;
    var eca2: X509 = zero(X509);
    x509_parse(&mut eca2, ecap, ecal);
    ok += check("ecdsa_eca_self", x509_signed_by(&mut eca, &mut eca2, 1767225600) as i64, 1);
    total += 1;

    // Full chain walk with the ECDSA CA as the anchor.
    var echain: X509Chain = zero(X509Chain);
    x509_chain_init(&mut echain, elp);
    x509_chain_add(&mut echain, 0, ell);
    ok += check("ecdsa_chain", x509_chain_verify(&mut echain, ecap, ecal, "ec.test", rt_len("ec.test"), 1767225600) as i64, 1);
    total += 1;
    ok += check("ecdsa_chain_badhost", x509_chain_verify(&mut echain, ecap, ecal, "nope.test", rt_len("nope.test"), 1767225600) as i64, 0);
    total += 1;
    ok += check("ecdsa_chain_wrong_anchor", x509_chain_verify(&mut echain, cap, cal, "ec.test", rt_len("ec.test"), 1767225600) as i64, 0);
    total += 1;

    printf("x509_passed=%d of %d\n", ok, total);
    if (ok == total) {
        return 0;
    }
    return 1;
}
